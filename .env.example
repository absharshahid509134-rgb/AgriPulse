# AGRIPULSE — Optional External Integrations Configuration
# The complete demo application works out-of-the-box without any environment variables.
# Never expose private database service-role keys or secret LLM API keys in VITE_* frontend variables.

# Optional: Live Weather API Proxy or Public Client Key (e.g., OpenWeatherMap or Open-Meteo proxy)
VITE_WEATHER_API_URL=
VITE_WEATHER_API_KEY=

# Optional: Backend AI Assistant & Crop Image Analysis Proxy Endpoint
# (Connects to your secure backend server holding your private LLM / Vision model keys)
VITE_AI_BACKEND_ENDPOINT=

# Optional: Verified Agricultural News Feed Endpoint
VITE_NEWS_API_ENDPOINT=

# Optional: Persistent Backend Configuration (e.g., Supabase public project URL & anon key with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
